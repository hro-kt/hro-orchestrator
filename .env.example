# DB(他コンポーネントと同じものを使う)
POSTGRES_HOST=hro-db-prod1.postgres.database.azure.com
POSTGRES_DATABASE=hro
POSTGRES_USER=hrouser
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Azure
ORC_RESOURCE_GROUP=prod1
ORC_WINDOWS_VM=hro-sync-prod2

# いつ何をするか(すべて JST)
# ★start_lead は「人が手で起こせる余裕」。起動に失敗した日は、
#   気づくのが遅いと一日を丸ごと失う。短くしすぎないこと。
ORC_START_LEAD_HOURS=3
ORC_ENQUEUE_LEAD_HOURS=2
ORC_AGENT_WAIT_MIN=20
ORC_STOP_AFTER_MIN=30

# race_day に渡す flow の設定(admin UI で使っているものと同じ JSON)
ORC_FLOW_ARGS={"thresholds":"{\"90\": 0.0345}","source":"netkeiba","lead_seconds":90,"flow_minutes":6,"act_before_deadline_seconds":29,"bet_type":"tan:2000,umatan:300","min_ninki":7,"mode":"live","confirm_live":true,"max_amount_per_order":14000,"max_amount_per_day":100000}

# ★死活監視(強く推奨)。1周ごとに ping し、途切れたら外部が鳴る。
#   司令塔自身が落ちたことは司令塔には報告できない。これだけは外部に置くこと。
#   healthchecks.io / Better Stack などの URL。猶予は 30 分くらいが目安
#   (timer は10分ごとなので、2回落としたら鳴る)。
ORC_HEARTBEAT_URL=

# 異常の通知(Slack 互換の {"text": ...} を POST)
ORC_ALERT_WEBHOOK=
